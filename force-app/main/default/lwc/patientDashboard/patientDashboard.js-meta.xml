<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Patient Dashboard</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="findCarePage" type="String" default="Book_Appointment" label="(Old, not used) Find care page API name"/>
            <property name="checkBillPage" type="String" default="Coverage_Checker" label="(Old, not used) Check a bill page API name"/>
            <property name="profilePage" type="String" default="Patient_Registration" label="(Old, not used) Profile page API name"/>
            <property name="findCareUrl" type="String" default="/coveragechecker/book-appointment" label="Find a doctor page URL"/>
            <property name="checkBillUrl" type="String" default="/coveragechecker/coverage-checker" label="Check a bill page URL"/>
            <property name="profileUrl" type="String" default="/coveragechecker/insurance-setup" label="Insurance info page URL"/>
            <property name="homeUrl" type="String" default="/coveragechecker/" label="Home page URL"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>