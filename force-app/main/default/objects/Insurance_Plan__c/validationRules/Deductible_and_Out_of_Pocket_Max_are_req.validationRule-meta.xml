<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Deductible_and_Out_of_Pocket_Max_are_req</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL(Plan_Type__c,&quot;Dental&quot;)), OR(ISBLANK(Deductible__c), ISBLANK(Out_of_Pocket_Max__c)))</errorConditionFormula>
    <errorDisplayField>Deductible__c</errorDisplayField>
    <errorMessage>Deductible and Out of Pocket Max are required for non-dental plans.</errorMessage>
</ValidationRule>
