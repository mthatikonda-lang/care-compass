    <decisions>
        <name>Rule_Excluded_Or_Missing</name>
        <label>Rule_Excluded_Or_Missing</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Cost_Sharing_Method_Check</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Rule Applies</defaultConnectorLabel>
        <rules>
            <name>Excluded_or_Missing</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Coverage_Rule</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Coverage_Rule.Excluded__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
