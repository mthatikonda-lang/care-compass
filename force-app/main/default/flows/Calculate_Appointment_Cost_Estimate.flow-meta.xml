            </connector>
            <label>Excluded or Missing</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>BilledAmount</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!$Record.Estimated_Billed_Amount__c}),
   {!Get_Price_Benchmark.Average_Cost__c},
   {!$Record.Estimated_Billed_Amount__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CopayCost</name>
        <dataType>Currency</dataType>
        <expression>MIN({!BilledAmount}, {!Get_Coverage_Rule.Copay_Amount__c})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>DeductibleCoinsurance</name>
        <dataType>Currency</dataType>
        <expression>MIN(BLANKVALUE({!Get_Insurance_Plan.Out_of_Pocket_Max__c}, 999999999), MIN({!BilledAmount}, BLANKVALUE({!Get_Insurance_Plan.Deductible__c}, 0)) + MAX({!BilledAmount} - BLANKVALUE({!Get_Insurance_Plan.Deductible__c}, 0), 0) * BLANKVALUE({!Get_Insurance_Plan.Coinsurance_Rate__c}, 0) / 100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>IsInNetwork</name>
        <dataType>Boolean</dataType>
        <expression>AND({!$Record.Network_Found__c} = TRUE, {!$Record.Network_Tier_Result__c} &lt;&gt; &quot;Out-of-Network&quot;)</expression>
    </formulas>
    <interviewLabel>Calculate Appointment Cost Estimate {!$Flow.CurrentDateTime}</interviewLabel>
