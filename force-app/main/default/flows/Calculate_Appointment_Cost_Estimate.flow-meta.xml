    <decisions>
        <name>Cost_Sharing_Method_Check</name>
        <label>Cost_Sharing_Method_Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>treat as full bill (safety net) or route to Set_Cost_Full_Bill</defaultConnectorLabel>
        <rules>
            <name>Flat_Copay</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Coverage_Rule.Cost_Sharing_Method__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Flat Copay</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Cost_Copay</targetReference>
            </connector>
            <label>Flat Copay</label>
        </rules>
        <rules>
            <name>Deductible_Coinsurance</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Coverage_Rule.Cost_Sharing_Method__c</leftValueReference>
